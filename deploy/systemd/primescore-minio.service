[Unit]
Description=PrimeScore MinIO object storage
After=network-online.target
Wants=network-online.target
PartOf=primescore.target

[Service]
Type=notify
User=primescore
Group=primescore
EnvironmentFile=/etc/primescore/primescore.env
ExecStart=/usr/local/bin/minio server /var/lib/primescore/minio --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/primescore/minio

[Install]
WantedBy=primescore.target

[Unit]
Description=PrimeScore FastAPI API
After=network-online.target postgresql.service primescore-redis.service primescore-minio.service
Requires=postgresql.service primescore-redis.service primescore-minio.service
PartOf=primescore.target

[Service]
Type=simple
User=primescore
Group=primescore
WorkingDirectory=/opt/primescore/current/backend
EnvironmentFile=/etc/primescore/primescore.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/primescore/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/primescore

[Install]
WantedBy=primescore.target

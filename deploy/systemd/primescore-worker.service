[Unit]
Description=PrimeScore Celery worker
After=network-online.target postgresql.service primescore-redis.service primescore-minio.service
Requires=postgresql.service primescore-redis.service primescore-minio.service
PartOf=primescore.target

[Service]
Type=simple
User=primescore
Group=primescore
WorkingDirectory=/opt/primescore/current/backend
EnvironmentFile=/etc/primescore/primescore.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/primescore/current/backend/.venv/bin/celery -A app.tasks.celery_app worker --loglevel=info -Q default,heavy,notifications,admin_ai,writing --concurrency=4 -Ofair
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/primescore

[Install]
WantedBy=primescore.target

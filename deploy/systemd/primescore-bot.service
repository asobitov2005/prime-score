[Unit]
Description=PrimeScore Telegram bot
After=network-online.target postgresql.service primescore-redis.service
Requires=postgresql.service primescore-redis.service
PartOf=primescore.target

[Service]
Type=simple
User=primescore
Group=primescore
WorkingDirectory=/opt/primescore/current/backend
EnvironmentFile=/etc/primescore/primescore.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/primescore/current/backend/.venv/bin/python -m app.bot.main
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/primescore

[Install]
WantedBy=primescore.target
